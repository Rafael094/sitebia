# =====================================================================
#  Variáveis de ambiente — Bianca Martins (Next.js + Supabase)
#  Copie este arquivo para `.env.local` e preencha com seus valores.
#  As chaves podem ser encontradas no painel do Supabase:
#  Project Settings > API
# =====================================================================

# URL pública do projeto Supabase (ex.: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima ("anon key") — pública, usada no cliente/frontend
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço ("service_role") — PRIVADA, usada SOMENTE no servidor
# (em Server Actions / Route Handlers) para operações administrativas.
# Nunca exponha esta chave ao navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Chaves de autenticação via cookies (assinatura) — gera valores aleatórios seguros
# e mantenha consistentes entre ambientes: https://crypto.randomUUID()
# SUPABASE_AUTH_COOKIE_NAME=sb-auth-token

# =====================================================================
#  SMTP — envio dos e-mails do formulário de contato
#  Configure no .env.local (local) OU em Vercel → Settings → Environment
#  Variables (Production / Preview) e faça Redeploy.
#
#  PROVEDOR ATUAL DO PROJETO: BREVO
#    Painel Brevo → SMTP & API → aba "SMTP" → "SMTP credentials"
#    SMTP_HOST = smtp-relay.brevo.com
#    SMTP_PORT = 587            (STARTTLS — recomendado / liberado na Vercel)
#    SMTP_USER = <login SMTP>   (ex.: 8f2c1b001@smtp-brevo.com — veja no painel)
#    SMTP_PASS = <SMTP key>     (chave gerada em "SMTP credentials", NÃO é a senha da conta)
#    SMTP_FROM = e-mail de um remetente verificado em Senders/domínio autenticado
#
#  Outros provedores (referência):
#    Gmail      smtp.gmail.com       587  (senha de app)
#    Resend     smtp.resend.com      465  user=resend  pass=re_xxx
#    SendGrid   smtp.sendgrid.net    587  user=apikey  pass=SG.xxx
#    Locaweb    email-ssl.com.br     465
#    Hostinger  smtp.hostinger.com   465
# =====================================================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=seu-login@smtp-brevo.com
SMTP_PASS=sua-smtp-key-do-brevo

# Remetente exibido no "De:" (opcional; o padrão usa SMTP_USER).
# No Brevo o endereço/domínio precisa estar verificado (Senders & Domains),
# senão o envio é recusado com erro de remetente não autorizado.
# SMTP_FROM=Site Bianca Martins <contato@biancamartinsinovacao.com.br>

# Força TLS na conexão (opcional). Padrão: true na 465, false nas demais.
# Use quando o provedor usar uma porta fora do padrão (ex.: 2525).
# SMTP_SECURE=false

# E-mail de DESTINO onde Bianca recebe as mensagens — também editável no painel
# em /admin/configuracoes. Quando ambos vazios, cai no SMTP_USER.
# CONTACT_RECIPIENT_EMAIL=bmadvogada@gmail.com

# =====================================================================
#  SEO dinâmico com IA (DeepSeek)
#  https://platform.deepseek.com  ->  API Keys
# =====================================================================
# Chave da API do DeepSeek. Sem ela o painel continua funcionando: o SEO é
# gerado por uma heurística local (título/descrição/keywords), sem quebra.
#
# NÃO coloque a chave real neste arquivo (ele é versionado no Git).
# Configure o segredo apenas:
#   - LOCAL:  no arquivo .env.local (ignorado pelo Git)  OU
#   - PRODUÇÃO (Vercel): Project > Settings > Environment Variables
#     Name: DEEPSEEK_API_KEY   Value: sk-...   (Production / Preview / Dev)
DEEPSEEK_API_KEY=

# (Opcional) Endpoint compatível com OpenAI. Padrão:
# https://api.deepseek.com/chat/completions
# DEEPSEEK_API_URL=

# (Opcional) Modelo usado na geração de metadados. Padrão: deepseek-chat
# DEEPSEEK_MODEL=

# =====================================================================
#  Geração de imagem de CAPA dos artigos (opcional / plugável)
# =====================================================================
# Por padrão, a capa do artigo gerado pela IA é criada no próprio servidor
# (identidade da marca: azul-marinho + dourado, título + categoria) via
# `next/og` e enviada ao bucket público "article-covers" — sem custo nem
# chave extra.
#
# Para usar um provedor EXTERNO de geração de imagens, defina a URL abaixo.
# Contrato aceito: POST com JSON { prompt, size } que devolva:
#   - a imagem em binário (Content-Type: image/*), OU
#   - JSON { url }  |  { data: [{ url }] }  |  { b64_json }.
# Se o provedor falhar, o sistema volta automaticamente para a capa de marca.
# IMAGE_GEN_API_URL=
# IMAGE_GEN_API_KEY=

# =====================================================================
#  Keep-alive do Supabase (evita pausa por inatividade no plano free)
# =====================================================================
# A rota GET /api/keep-alive faz uma leitura simples no banco. O Vercel Cron
# (configurado em vercel.json, 1x/dia) a chama automaticamente para manter o
# projeto Supabase ativo.
#
# Opcional (recomendado): proteja a rota com um segredo. Quando definido, ela
# exige o cabeçalho 'Authorization: Bearer <CRON_SECRET>' — que o Vercel Cron
# já envia sozinho. Sem esta variável, a rota fica aberta para teste manual.
# Use um valor aleatório e longo (ex.: openssl rand -hex 32).
# CRON_SECRET=

# =====================================================================
#  Analytics & BI (rastreamento de acessos anonimizado)
# =====================================================================
# A tabela `page_views` (ver supabase/migrations_v9_analytics.sql) alimenta o
# painel "Analytics & BI". Nenhum IP é armazenado: guardamos apenas um hash
# SHA-256 do visitante (IP + User-Agent + salt) para contar visitantes únicos.
#
# Opcional: defina um "salt" próprio para o hash. Se omitido, usa o padrão
# interno do projeto. Use um valor aleatório e longo (ex.: openssl rand -hex 32).
# ANALYTICS_SALT=

# =====================================================================
#  Google reCAPTCHA v2 (checkbox) — formulários públicos e login do painel
#  Crie as chaves em https://www.google.com/recaptcha/admin
#  Tipo: reCAPTCHA v2 → "Não sou um robô" (caixa de seleção)
#  NEXT_PUBLIC_RECAPTCHA_SITE_KEY = chave pública (vai ao navegador)
#  RECAPTCHA_SECRET_KEY           = chave secreta (somente no servidor)
#  Sem as duas, o widget não aparece e a validação é dispensada.
# =====================================================================
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
